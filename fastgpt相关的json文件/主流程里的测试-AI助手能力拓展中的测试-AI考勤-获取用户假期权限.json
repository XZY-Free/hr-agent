        {
          "key": "code",
          "renderTypeList": [
            "custom"
          ],
          "label": "",
          "value": "// 获取盖亚 JWT 权限\nfunction main({response}) {\n\n    var flag = false;\n    var result = [];\n    var errorMsg = \"\";\n    try {\n        var dataJson = JSON.parse(response);\n        if (dataJson.result) {\n            var employeeData = dataJson.data\n            for (var i = 0; i < employeeData.length; i++) {\n                var employee = employeeData[i];\n                var LeaveCode = employee.LeaveCode;\n                var LeaveType = employee.LeaveType;\n                var leave = {\n                    \"LeaveCode\": LeaveCode,\n                    \"LeaveType\": LeaveType\n                }\n                result.push(leave);\n            }\n        } else {\n            errorMsg = \"获取盖亚JWT权限失败，message=\" + dataJson.message;\n            flag = false;\n        }\n\n    } catch (e) {\n        flag = false;\n        errorMsg = \"获取盖亚用户请假权限失败，JSON格式错误，json=\" + response;\n    }\n\n\n    return {\n        flag: flag,\n        result: result,\n        errorMsg: errorMsg\n    }\n}",
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": "",
          "valueType": "string"
        },

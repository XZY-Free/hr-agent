          ],
          "label": "",
          "value": "function main({response}) {\n    var dataJson = JSON.parse(response);\n    var details = dataJson.details\n    var result = {}\n    for (var i = 0; i < details.length; i++) {\n        var item = details[i]\n        // 总额度\n        var quota = item.quota\n        // 已使用额度\n        var used = item.used\n        // 剩余额度\n        var balance = item.balance\n        result = {\n            // 可休额度\n            quota: quota,\n            // 已使用天数\n            used: used,\n            // 剩余可使用额度\n            balance: balance,\n        }\n    }\n    return {\n        result: result\n    }\n}",
